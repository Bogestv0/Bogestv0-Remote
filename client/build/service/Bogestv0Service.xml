<service>
  <id>Bogestv0Remote</id>
  <name>Bogestv0 REMOTE</name>
  <description>Расширенный доступ Bogestv0 REMOTE: UAC и экран входа (только с подтверждением пользователя).</description>
  <executable>%BASE%\..\..\Bogestv0 REMOTE.exe</executable>
  <arguments>"%BASE%\..\app.asar.unpacked\src\service\service-main.js"</arguments>
  <env name="ELECTRON_RUN_AS_NODE" value="1"/>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="5 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <log mode="roll-by-size"><sizeThreshold>1024</sizeThreshold><keepFiles>2</keepFiles></log>
</service>
